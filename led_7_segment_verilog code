
module led_7_segment (
    input A,B,C,D,
    output a,b,c,d,e,f,g
    );
    
    assign a = A | C | (~B & ~D) | ( B & D);
    assign b = ~B | (~C & ~D) | (C & D);
    assign c = ~C | B | D;
    assign d = (~B & ~D) | (C & ~D) | (~B & C) | (B & ~C & D)| A;
    assign e = (C & ~D )| (~B & ~D);
    assign f = (~C & ~D ) | (B & ~C) | A | (B& ~D);
    assign g =  A | (B & ~C) | (C & ~D) | (~B & C );
    
    endmodule 

